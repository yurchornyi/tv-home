<?xml version="1.0" encoding="utf-8"?>
<!-- Home while an app opens: it grows a little and fades out under the app, as Apple TV's home does when an app
     expands over it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_decelerate"
    android:duration="280">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" />
    <scale android:fromXScale="1.0" android:toXScale="1.08"
        android:fromYScale="1.0" android:toYScale="1.08"
        android:pivotX="50%" android:pivotY="50%" />
</set>
