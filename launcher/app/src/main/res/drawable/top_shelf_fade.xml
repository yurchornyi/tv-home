<?xml version="1.0" encoding="utf-8"?>
<!-- Over the softened top shelf art: a dim so the name and pills stay readable, and the lower half fading into the
     black background behind the dock and the grid. One gradient, not a dim plus a gradient: each full-screen layer
     is a whole extra pass for a TV's GPU. The colours are the two layers composed: the 25% dim at the top, 92.5%
     at a third of the way up, solid black at the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF000000"
        android:centerColor="#EC000000"
        android:centerY="0.35"
        android:endColor="#40000000" />
</shape>
