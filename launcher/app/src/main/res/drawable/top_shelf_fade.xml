<?xml version="1.0" encoding="utf-8"?>
<!-- Over the softened top shelf art: a dim so the name and pills stay readable, and the lower half fading into the
     black background behind the dock and the grid. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FF000000"
                android:centerColor="#E6000000"
                android:centerY="0.35"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
