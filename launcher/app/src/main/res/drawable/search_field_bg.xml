<?xml version="1.0" encoding="utf-8"?>
<!-- The Search text field (SearchDialog): the same glass as the pills, its rim a little brighter while it is typed in,
     never the white filled look of a focused pill (the keyboard is what has the focus then). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#24FFFFFF" />
            <stroke android:width="1.5dp" android:color="#A6FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</selector>
